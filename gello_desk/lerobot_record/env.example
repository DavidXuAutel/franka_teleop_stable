# Example env for LeRobot episode recorder (copy to .env — do not commit secrets)
LEROBOT_RECORD_HOST=127.0.0.1
LEROBOT_RECORD_PORT=8765
FPS=15
LOCAL_DATASET_ROOT=/home/yao/lerobot_datasets
DEFAULT_REPO=fr3_gello_teleop
DEFAULT_TASK="franka gello teleop"

# ROS topics — joints
FRANKA_JOINT_TOPIC=/franka/joint_states
GELLO_JOINT_TOPIC=/gello/joint_states
GRIPPER_JOINT_TOPIC=/franka_gripper/joint_states
GELLO_GRIPPER_TOPIC=/gripper/gripper_client/target_gripper_width_percent

# Dual RealSense via ROS nodes (see start_dual_realsense.sh)
CAM1_TOPIC=/cam1/cam1/color/image_raw
CAM2_TOPIC=/cam2/cam2/color/image_raw
CAM1_SERIAL=247122072824
CAM2_SERIAL=141722071359

# Remote archive (rsync after each episode stop)
REMOTE_SSH=a25689@10.239.121.11
REMOTE_PORT=31126
REMOTE_PATH=~/lerobot_datasets
# Prefer key-based auth. If needed only on the teleop server:
# SSHPASS=********
# SSH_KEY=/home/yao/.ssh/id_ed25519_lerobot
